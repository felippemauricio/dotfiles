{
  "name": "dotfiles",
  "version": "1.0.0",
  "description": "Documentation site for the dotfiles repository",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev website",
    "docs:build": "vitepress build website",
    "docs:preview": "vitepress preview website",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:sh": "shellcheck install.sh scripts/*.sh",
    "check": "npm run lint && npm run lint:sh && npm run format:check && npm run test && npm run docs:build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felippemauricio/dotfiles.git"
  },
  "author": {
    "name": "Felippe Maur\u00edcio",
    "email": "felippemauriciov@gmail.com",
    "url": "https://github.com/felippemauricio"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitepress": "^2.0.0-alpha.17",
    "vitest": "^4.1.9"
  }
}
